# ==============================================================================
# ARTEMIS upstream .env template — proxy-only mode
# (docs/artemis-upstream-proxy-only.md 참고)
# ==============================================================================
# scripts/setup_artemis_upstream.ps1 이 이 파일을 <artemis-upstream>\.env 로 복사합니다.
# 사내망에서는 Google/OpenAI/Anthropic API 호스트에 직접 연결하는 경로가 TLS 단계에서
# 막혀 있고, 사내 LiteLLM 프록시(OpenAI 호환)만 통과 가능합니다. 아래 값들은 그 전제로
# 채워야 합니다. 실제 값을 채운 뒤에는 이 파일이 아니라 <artemis-upstream>\.env 만
# 수정하세요 — 이 템플릿(.env.example)에는 real key를 절대 넣지 마세요.

# ----- 사내 LiteLLM 프록시 (OpenAI 호환 엔드포인트) --------------------------
# 팀에서 제공하는 사내 프록시 주소로 교체하세요.
OPENAI_BASE_URL=https://<internal-litellm-proxy>/v1
# 팀에서 발급한 LiteLLM virtual key.
OPENAI_API_KEY=<litellm-virtual-key>

# ----- Google 직결 비활성화 (필수: 반드시 비워 둘 것) -------------------------
# 사내망은 Google API를 직접 호출할 수 없습니다. 값이 비어 있어야 patches/의 패치가
# openai 프로바이더 경로만 타도록 강제한 설정이 그대로 유지됩니다. 값을 채우면
# 일부 코드 경로가 다시 Google API로 직결을 시도해 TLS 오류가 납니다.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ----- Android ADB 연결 -------------------------------------------------------
# 기본값(127.0.0.1:5037)을 쓰지 않는 경우에만 채우세요.
# adb devices -l 로 확인한 기기 시리얼을 넣으세요. 기기가 하나뿐이면 비워 둬도 됩니다.
ADB_DEVICE_SERIAL=

# ----- UI hierarchy 백엔드 ----------------------------------------------------
# auto: Accessibility Helper 우선, UIAutomator2로 폴백. 프록시 키가
# gemini-robotics-er-2-preview(업스트림 기본 그라운딩 모델)를 허용하지 않으므로,
# gemini-3.5-flash + UI-tree 백엔드 조합으로 그라운딩 정확도를 보완합니다.
ARTEMIS_HIERARCHY_BACKEND=auto

# ----- 실행 프로파일 -----------------------------------------------------------
ARTEMIS_DEFAULT_PROFILE=flash
