# ===== ADK model backend =====================================================
# auto | anthropic | gemini   (auto: GOOGLE_API_KEY 있으면 gemini, 없으면 anthropic)
ADK_MODEL_BACKEND=auto

# ----- (A) Anthropic-compatible LiteLLM proxy (기본 경로) --------------------
# 아래 두 변수는 ADK 내부의 공식 Anthropic SDK가 자동으로 읽는다.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ADK_ANTHROPIC_MODEL=claude-sonnet-5
ADK_MAX_TOKENS=8192

# ----- (B) Gemini (선택: AI Studio 키가 생기면) ------------------------------
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# ADK_GEMINI_MODEL=gemini-flash-latest
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
#   ^ google-genai 신규 이름은 GOOGLE_GENAI_USE_ENTERPRISE (둘 다 인식,
#     충돌 시 ENTERPRISE 우선). Vertex를 쓸 때만 TRUE + 아래 두 줄 필요.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ===== ARTEMIS host (Phase 2: Gemini 키 + Android 기기 확보 후) ==============
ARTEMIS_BASE_URL=http://127.0.0.1:8000
# ARTEMIS_TOKEN=
ARTEMIS_DEFAULT_PROFILE=flash
# ARTEMIS_DEVICE_SERIAL=
ARTEMIS_REQUEST_TIMEOUT=30
ARTEMIS_TASK_TIMEOUT=1800

# ===== ARTEMIS MCP bridge (Phase 3, 선택) ===================================
ARTEMIS_MCP_ENABLED=false
# ARTEMIS_REPO_DIR=C:\Users\siheon.ryu\Desktop\workspace\R2P\artemis-upstream
